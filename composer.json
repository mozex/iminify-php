{
    "name": "mozex/iminify-php",
    "description": "PHP client for the Iminify image optimization API, with an optimizer for Spatie's image packages",
    "keywords": [
        "iminify",
        "image-optimization",
        "image-compression",
        "webp",
        "avif",
        "api-client",
        "spatie",
        "image-optimizer",
        "mozex"
    ],
    "homepage": "https://github.com/mozex/iminify-php",
    "license": "MIT",
    "authors": [
        {
            "name": "Mozex",
            "email": "hello@mozex.dev",
            "homepage": "https://mozex.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2.0",
        "composer-runtime-api": "^2.0",
        "php-http/discovery": "^1.20",
        "psr/http-client": "^1.0.3",
        "psr/http-client-implementation": "^1.0.1",
        "psr/http-factory": "^1.1",
        "psr/http-factory-implementation": "^1.0",
        "psr/http-message": "^1.1|^2.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.9.3|^8.0",
        "guzzlehttp/psr7": "^2.7|^3.0",
        "laravel/pint": "^1.14",
        "pestphp/pest": "^3.8.2|^4.0.0|^5.0.0",
        "pestphp/pest-plugin-type-coverage": "^3.5|^4.0.0|^5.0.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.5|^12.0|^13.0",
        "psr/log": "^1.1.4|^2.0|^3.0",
        "spatie/image": "^3.8",
        "spatie/image-optimizer": "^1.10"
    },
    "conflict": {
        "spatie/image-optimizer": "<1.10.0"
    },
    "suggest": {
        "phpunit/phpunit": "For the assertions of Testing\\FakeClient",
        "spatie/image-optimizer": "For Spatie\\IminifyOptimizer, which needs version 1.10 or newer",
        "spatie/image": "To optimize an image through Spatie\\IminifyOptimizer as you save it, and for Browsershot to do the same"
    },
    "autoload": {
        "psr-4": {
            "Mozex\\Iminify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mozex\\Iminify\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint",
        "test:lint": "pint --test",
        "test:types": "phpstan analyse --ansi",
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:unit": "pest --colors=always",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ]
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": false,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
